<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 400" width="100%" height="100%">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#8B1E1E"/>
      <stop offset="50%" stop-color="#6B1212"/>
      <stop offset="100%" stop-color="#4A0A0A"/>
    </linearGradient>
    <linearGradient id="goldGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#FFE27A"/>
      <stop offset="50%" stop-color="#D4AF37"/>
      <stop offset="100%" stop-color="#AA820A"/>
    </linearGradient>
  </defs>
  <circle cx="200" cy="200" r="190" fill="url(#bgGrad)" stroke="url(#goldGrad)" stroke-width="8"/>
  <circle cx="200" cy="200" r="172" fill="none" stroke="url(#goldGrad)" stroke-width="2" stroke-dasharray="6,4"/>
  <circle cx="200" cy="200" r="95" fill="#580D0D" stroke="url(#goldGrad)" stroke-width="4"/>
  <g fill="url(#goldGrad)" text-anchor="middle">
    <polygon points="200,130 204,142 216,142 206,150 210,162 200,154 190,162 194,150 184,142 196,142"/>
    <text x="200" y="215" font-family="'Playfair Display', Georgia, serif" font-size="52" font-weight="700" letter-spacing="2">SN</text>
  </g>
  <path id="textArcTop" d="M 75,200 A 125,125 0 0,1 325,200" fill="none"/>
  <text fill="#FFFFFF" font-family="'Poppins', sans-serif" font-size="22" font-weight="700" letter-spacing="4" text-anchor="middle">
    <textPath href="#textArcTop" startOffset="50%">SINAR NORRAY</textPath>
  </text>
  <text x="200" y="245" fill="url(#goldGrad)" font-family="'Poppins', sans-serif" font-size="12" font-weight="600" letter-spacing="3" text-anchor="middle">
    SENI &amp; BUDAYA BETAWI
  </text>
  <text x="200" y="268" fill="#FBD38D" font-family="'Poppins', sans-serif" font-size="11" font-weight="500" letter-spacing="2" text-anchor="middle">
    EST. 1995 • HJ. NORI
  </text>
</svg>
